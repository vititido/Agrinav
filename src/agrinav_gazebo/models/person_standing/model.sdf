<?xml version="1.0" ?>
<!-- OpenRobotics "Standing person" (CC0-1.0, created by Marina Kollmitz with
     MakeHuman), made static. The mesh collision is replaced by a cylinder:
     the people in the orchard never move and a 4.5 MB collision mesh only
     slows the physics step. -->
<sdf version="1.9">
  <model name="person_standing">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 -0.07 0.95 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.3</radius>
            <length>1.9</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.02 0.04 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://person_standing/meshes/standing.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
