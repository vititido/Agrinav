<?xml version="1.0" ?>
<!-- OpenRobotics "Cardboard box" (CC0-1.0), made static. Footprint 0.5 x 0.4 m,
     0.3 m tall, origin on the ground. -->
<sdf version="1.9">
  <model name="cardboard_box">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry>
          <box>
            <size>0.5 0.4 0.3</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://cardboard_box/meshes/cardboard_box.dae</uri>
            <scale>1.25931896 1.007455168 0.755591376</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
