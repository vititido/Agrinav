<?xml version="1.0" ?>
<!-- Orchard tree from primitives. Built here instead of taken from Fuel: the
     Fuel oak's roots spread 2 m at ground level, which makes the trunk position
     ambiguous in the lidar scan and in the ground truth. Dimensions match the
     tree entry in config/worlds.yaml. -->
<sdf version="1.9">
  <model name="orchard_tree">
    <static>true</static>
    <link name="link">
      <collision name="trunk">
        <pose>0 0 0.8 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>1.6</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="trunk">
        <pose>0 0 0.8 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>1.6</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.30 0.20 0.12 1</ambient>
          <diffuse>0.40 0.27 0.15 1</diffuse>
        </material>
      </visual>
      <visual name="crown_low">
        <pose>0 0 2.1 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>1.0</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.10 0.30 0.08 1</ambient>
          <diffuse>0.18 0.45 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="crown_top">
        <pose>0.15 0.1 2.8 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.7</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.12 0.33 0.09 1</ambient>
          <diffuse>0.20 0.50 0.14 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
