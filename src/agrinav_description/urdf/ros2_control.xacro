<?xml version="1.0"?>
<!-- Velocity-commanded wheels for diff_drive_controller (two wheels per side).
     The same block drives real hardware by swapping the plugin. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="wheel_interfaces" params="joint">
    <joint name="${joint}">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="agrinav_ros2_control" params="controllers_file">
    <ros2_control name="agrinav_system" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <xacro:wheel_interfaces joint="front_left_wheel_joint"/>
      <xacro:wheel_interfaces joint="rear_left_wheel_joint"/>
      <xacro:wheel_interfaces joint="front_right_wheel_joint"/>
      <xacro:wheel_interfaces joint="rear_right_wheel_joint"/>
    </ros2_control>

    <xacro:if value="${controllers_file != ''}">
      <gazebo>
        <plugin filename="gz_ros2_control-system"
                name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>${controllers_file}</parameters>
        </plugin>
      </gazebo>
    </xacro:if>
  </xacro:macro>

</robot>
